{
  "manifest_version": 3,
  "name": "知识库剪藏",
  "version": "0.1.0",
  "description": "一键剪藏网页内容到知识库",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:18800/*", "https://your-domain.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {}
}
